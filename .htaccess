# Закрываем служебные файлы от чужих глаз.
<FilesMatch "^(config\.php|leads\.csv|\.tokens|data\.backup\.js)$">
  Require all denied
</FilesMatch>

# На старых Apache директива выше не сработает — дублируем по-старому.
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|leads\.csv|\.tokens|data\.backup\.js)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Админку не индексируем.
<IfModule mod_headers.c>
  <FilesMatch "admin\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Сжатие и кэш статики.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 180 days"
</IfModule>
