# Редирект с http на https создан автоматически при заказе бесплатного
# ssl-сертификата reg.ru. Наш файл перезаписывает серверный, поэтому редирект
# перенесён сюда — без него сайт открывался бы и по http.
RewriteEngine On
RewriteCond %{SERVER_PORT} !^443$
RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R,L]

# Закрываем служебные файлы от чужих глаз. Основная защита не здесь:
# рабочие файлы лежат над корнем сайта, куда веб-сервер не ходит вовсе
# (nginx на шаред-хостинге раздаёт статику мимо .htaccess). Это второй рубеж
# на случай, если файл всё-таки окажется рядом с сайтом.
<FilesMatch "^(config\.php|leads\.csv|\.tokens|\.login-attempts|data\.backup\.js|data\.full\.json)$">
  Require all denied
</FilesMatch>

# На старых Apache директива выше не сработает — дублируем по-старому.
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|leads\.csv|\.tokens|data\.backup\.js)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Админку не индексируем.
<IfModule mod_headers.c>
  <FilesMatch "admin\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Заголовки безопасности.
<IfModule mod_headers.c>
  # Браузер не должен угадывать тип файла: подсунутый под видом картинки
  # скрипт не выполнится.
  Header always set X-Content-Type-Options "nosniff"
  # Чужой сайт не сможет спрятать нашу страницу в невидимый iframe и ловить
  # на ней клики. SAMEORIGIN, а не DENY: админка сама показывает витрину
  # в рамке предпросмотра.
  Header always set X-Frame-Options "SAMEORIGIN"
  # На чужие адреса уходит только домен, без пути: партнёрским ссылкам
  # источник нужен, а знать конкретную страницу им незачем.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Ничего из этого сайту не нужно, а спросить у посетителя могла бы
  # только чужая врезка.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Пока у витрины нет своего домена, она живёт подпапкой на чужом хостинге.
# Оттуда её индексировать не надо: это не сайт того домена, и в выдаче ему
# делать нечего. На своём домене правило само перестанет срабатывать.
<IfModule mod_headers.c>
  SetEnvIf Host "full-worker\.ru" TEMP_HOME=1
  Header set X-Robots-Tag "noindex, nofollow" env=TEMP_HOME
</IfModule>

# Сжатие и кэш статики.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 180 days"
</IfModule>
